# ---------------------------------------------------------------------------
# Behavioral Biometric Authentication — example environment configuration.
#
# Copy to `.env` and fill in REAL values there. `.env` is git-ignored; this
# file ships only placeholders and NEVER a real secret.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Application identity -----------------------------------------------------
BBA_APP_NAME=Behavioral Biometric Authentication API
BBA_APP_VERSION=0.1.0
BBA_ENVIRONMENT=development
BBA_DEBUG=false
BBA_API_PREFIX=/api/v1

# CORS: explicit origins only (never "*").
BBA_CORS_ORIGINS=http://localhost:5173

# ML artifacts (Phase 7 checkpoint + Phase 9B inference artifacts) ---------
BBA_CHECKPOINT_PATH=models/siamese_behavioral_encoder.pt
BBA_PREPROCESSING_ARTIFACT_PATH=models/behavioral_preprocessing.json
BBA_VERIFICATION_CONFIG_PATH=models/verification_config.json

# PostgreSQL (Phase 10/11: profiles + accounts) ----------------------------
# Leave empty to use the non-persistent in-memory stores (dev/tests only).
# BBA_DATABASE_URL=postgresql://user:password@localhost:5432/behavioral

# Authentication (Phase 11) -------------------------------------------------
# REQUIRED: replace with a long random secret (>= 32 characters) before any
# auth endpoint can issue tokens. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is deliberately NO default secret — an empty value makes auth fail
# closed (503 auth_unavailable) instead of signing with a weak key.
BBA_JWT_SECRET_KEY=
BBA_JWT_ALGORITHM=HS256
BBA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30